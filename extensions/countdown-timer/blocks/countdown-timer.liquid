{%- comment -%}
  Decides before first paint whether to reserve space, using only the hint and the product.
  See specs/05-widget.md. This file must never output merchant text.
{%- endcomment -%}
{%- assign hint = app.metafields.countdown.timer_hint.value -%}
{%- assign hint_missing = true -%}
{%- if hint.v == 1 and hint.overflow != true -%}
  {%- assign hint_missing = false -%}
{%- endif -%}

{%- assign matched = false -%}
{%- assign size = 'medium' -%}
{%- assign position = '' -%}
{%- unless hint_missing -%}
  {%- assign now_s = 'now' | date: '%s' | plus: 0 -%}
  {%- assign product_key = '|' | append: product.id | append: '|' -%}
  {%- for entry in hint.t -%}
    {%- assign in_window = false -%}
    {%- if entry.s == blank -%}
      {%- assign in_window = true -%}
    {%- else -%}
      {%- assign lead_in = entry.s | minus: 300 -%}
      {%- if now_s >= lead_in and now_s < entry.e -%}
        {%- assign in_window = true -%}
      {%- endif -%}
    {%- endif -%}
    {%- unless in_window -%}{%- continue -%}{%- endunless -%}

    {%- assign targets = false -%}
    {%- if entry.a == true or entry.p contains product_key -%}
      {%- assign targets = true -%}
    {%- else -%}
      {%- for collection_item in product.collections -%}
        {%- assign collection_key = '|' | append: collection_item.id | append: '|' -%}
        {%- if entry.c contains collection_key -%}
          {%- assign targets = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- if targets -%}
      {%- assign matched = true -%}
      {%- assign size = entry.z -%}
      {%- assign position = entry.o -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endunless -%}

{%- if hint_missing or matched -%}
  {%- assign reserved = 0 -%}
  {%- if position == 'inline' -%}
    {%- case size -%}
      {%- when 'small' -%}{%- assign reserved = 56 -%}
      {%- when 'large' -%}{%- assign reserved = 96 -%}
      {%- else -%}{%- assign reserved = 72 -%}
    {%- endcase -%}
  {%- endif -%}
  {%- assign sorted_ids = product.collections | map: 'id' | sort -%}
  {%- capture collection_ids -%}
    {%- for id in sorted_ids limit: 50 -%}{{ id }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
  {%- endcapture -%}
  <style>
    .cdt-root{display:block;width:100%}
    :has(>.cdt-root){box-sizing:border-box;width:100%;max-width:100%;align-self:stretch}
    .cdt-card{position:relative;box-sizing:border-box;display:flex;align-items:center;justify-content:center;width:100%;height:100%;overflow:hidden;padding:4px 12px;border-radius:12px;box-shadow:0 1px 6px rgba(0,0,0,.14);color:var(--cdt-fg);text-align:center;line-height:1.2}
    .cdt-card::before{content:"";position:absolute;inset:0;background:var(--cdt-bg)}
    .cdt-body{position:relative;min-width:0;max-width:100%}
    .cdt-headline,.cdt-description{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
    .cdt-headline{font-size:12px;letter-spacing:.04em}
    .cdt-description{font-size:11px}
    .cdt-clock{font-size:20px;font-weight:700;white-space:nowrap;font-variant-numeric:tabular-nums}
    .cdt-digit{display:inline-block;width:1ch;text-align:center}
    .cdt-small .cdt-body{display:flex;align-items:center;justify-content:center;gap:8px}
    .cdt-small .cdt-headline{min-width:0}
    .cdt-small .cdt-clock{flex:none;font-size:18px}
    .cdt-large .cdt-headline{font-size:14px}
    .cdt-large .cdt-clock{font-size:28px}
    .cdt-large .cdt-description{font-size:13px}
    .cdt-top_bar,.cdt-bottom_bar{position:fixed;left:0;right:0;z-index:2147483000;border-radius:0}
    .cdt-top_bar{top:0}
    .cdt-bottom_bar{bottom:0}
    .cdt-top_bar.cdt-small,.cdt-bottom_bar.cdt-small{height:56px}
    .cdt-top_bar.cdt-medium,.cdt-bottom_bar.cdt-medium{height:72px}
    .cdt-top_bar.cdt-large,.cdt-bottom_bar.cdt-large{height:96px}
    .cdt-urgent::before{animation:cdt-pulse 1.6s ease-in-out infinite}
    @keyframes cdt-pulse{50%{opacity:.7}}
    @media (prefers-reduced-motion:reduce){
      .cdt-urgent{color:var(--cdt-bg)}
      .cdt-urgent::before{animation:none;background:var(--cdt-fg)}
    }
  </style>
  <div
    id="cdt-{{ block.id }}"
    class="cdt-root"
    style="height:{{ reserved }}px"
    data-reserved="{{ reserved }}"
    data-product-id="{{ product.id }}"
    data-collection-ids="{{ collection_ids }}"
    data-proxy="/apps/countdown"
    {% if hint_missing %}data-hint-missing="true"{% endif %}
    {% if position == 'top_bar' or position == 'bottom_bar' %}data-bar="{{ position }}"{% endif %}
    {{ block.shopify_attributes }}
  ></div>
  <script src="{{ 'countdown-timer.js' | asset_url }}" defer></script>
{%- elsif request.design_mode -%}
  <div {{ block.shopify_attributes }} style="padding:12px;border:1px dashed #999;border-radius:8px;font-size:13px;text-align:center">
    Countdown timer: no timer applies to this product right now. Shoppers won't see this note.
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Countdown Timer",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": []
}
{% endschema %}
